# Copy to .env and fill in real values. `docker compose` reads this file
# automatically; sidekick also loads it via env_file in docker-compose.yml.
#
# Production reminder: run with `docker compose -f docker-compose.yml ...`
# (not bare `docker compose ...`) so docker-compose.override.yml — dev builds,
# bind mounts, published debug ports — never applies on the server.

# ── MongoDB (container init + app connection string) ──────────────────────
MONGO_ROOT_USERNAME=admin
# Use a long random value in production; this is the database root password.
MONGO_ROOT_PASSWORD=change-me
# Service name "mongodb" is the Docker network hostname — do not use
# localhost here, that only works for host-native (non-container) runs.
MONGODB_URL=mongodb://admin:change-me@mongodb:27017/sidekick?authSource=admin
MONGODB_DATABASE=sidekick

# qdrant_url is intentionally omitted: Qdrant is unused in the codebase today
# and is not part of this environment. Add it back (service + env var) if a
# feature starts depending on it.

# ── Application ─────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
DEV_MODE=false
DEV_ATHLETE_ID=

# ── Strava OAuth ────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must be reachable from the athlete's browser, i.e. the public domain below.
STRAVA_REDIRECT_URI=https://example.com/auth/strava/callback

# ── JWT session tokens ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── CORS ────────────────────────────────────────────────────────────────
# Must be a concrete origin in production: "*" is rejected by browsers
# once CORS_ALLOW_CREDENTIALS is true (the code default combination is
# dev-only — do not deploy with CORS_ORIGINS=*).
CORS_ORIGINS=https://example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── LLM (CrewAI) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_MAX_TOKENS=8192

# ── Memory consolidation / polarized-training tunables ─────────────────
# Sensible defaults from config.py; override only if you know you need to.
CONSOLIDATION_MIN_AGE=P1W
POWER_HISTOGRAM_BUCKET_WATTS=5.0
POLARIZED_GRAY_ZONE_DEPTH_FRAC=0.25
POLARIZED_LOW_TARGET_PCT=80.0
POLARIZED_GRAY_ZONE_LOW_PCT=75.0
POLARIZED_MIN_MODERATE_PCT=5.0
POLARIZED_MIN_CLASSIFIED_MINUTES=60.0
POLARIZED_MIN_TRAINING_DAYS=2

# ── Frontend / Caddy (automatic HTTPS via Let's Encrypt) ───────────────
DOMAIN=example.com
ACME_EMAIL=you@example.com
